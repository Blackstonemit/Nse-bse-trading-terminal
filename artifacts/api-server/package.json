{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "bin": "boot.cjs",
  "files": [
    "dist/**/*"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "pkg": "pkg . --target node18-win-x64 --output ../../TradingTerminal.exe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "pkg": {
    "scripts": [
      "dist/index.mjs"
    ],
    "assets": [
      "artifacts/market-dashboard/dist/public/**/*"
    ],
    "outputPath": "."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@libsql/client": "^0.14.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.27.0",
    "pino": "^9",
    "pino-http": "^10",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0"
  }
}
